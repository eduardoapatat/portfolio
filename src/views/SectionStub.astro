---
// Provisional: cada sección se reemplaza por su vista real en los pasos 8 a 10.
import ContentPanel from '@/components/ContentPanel.astro';

type Props = {
  title: string;
};

const { title } = Astro.props;
---

<ContentPanel>
  <h1 class="text-3xl font-bold md:text-4xl">{title}</h1>
  <div class="mt-8 space-y-4 text-fg-subtle">
    {Array.from({ length: 30 }, (_, i) => <p>Contenido de prueba {i + 1}</p>)}
  </div>
</ContentPanel>
