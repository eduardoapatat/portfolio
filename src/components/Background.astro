---
// Fondo de estrellas que siguen al cursor. Persiste entre páginas (transition:persist).
// El dibujo y el movimiento viven en src/scripts/background.ts.
---

<div
  aria-hidden="true"
  transition:persist="background"
  class="pointer-events-none fixed inset-0 -z-10 overflow-hidden bg-bg"
>
  <canvas data-background-canvas class="absolute inset-0 size-full"></canvas>
</div>

<script>
  import '@/scripts/background';
</script>
