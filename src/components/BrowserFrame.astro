---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

type Props = {
  class?: string;
  image?: ImageMetadata;
  alt?: string;
  url?: string;
  emptyLabel: string;
};

const { class: className, image, alt = '', url, emptyLabel } = Astro.props;
const host = url ? new URL(url).host : 'localhost';
---

<figure
  class:list={[
    'flex flex-col overflow-hidden rounded-xl border border-line bg-surface-raised',
    className,
  ]}
>
  <div class="flex items-center gap-3 border-b border-line px-3 py-2" aria-hidden="true">
    <span class="flex gap-1.5">
      <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
      <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
      <span class="size-2.5 rounded-full bg-[#28c840]"></span>
    </span>
    <span class="mx-auto max-w-[60%] truncate rounded-md bg-surface px-3 py-0.5 text-[11px] text-fg-subtle">
      {host}
    </span>
  </div>
  {image ? (
    <Image
      src={image}
      alt={alt}
      widths={[640, 960, 1280]}
      sizes="(min-width: 1024px) 35vw, 90vw"
      class="aspect-video w-full object-cover object-top"
    />
  ) : (
    <div class="grid aspect-video place-items-center text-fg-subtle">
      <span class="flex flex-col items-center gap-2 text-xs">
        <Icon name="lucide:image" class="size-7" aria-hidden="true" />
        {emptyLabel}
      </span>
    </div>
  )}
</figure>
