---
// Barra superior: marca, pestañas de sección, menú de comandos e idioma.
// En celular las pestañas bajan a una segunda fila bajo la marca; en escritorio la barra va sobre la columna de contenido.
import { Icon } from 'astro-icon/components';
import LanguagePicker from '@/components/LanguagePicker.astro';
import { profile } from '@/data/profile';
import type { RouteKey } from '@/i18n/routes';
import type { UiKey } from '@/i18n/ui';
import { getLang, getRouteKey, pathFor, useTranslations } from '@/i18n/utils';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const currentRoute = getRouteKey(Astro.url);

const tabs: { route: RouteKey; label: UiKey }[] = [
  { route: 'home', label: 'nav.home' },
  { route: 'projects', label: 'nav.projects' },
  { route: 'experience', label: 'nav.experience' },
  { route: 'cv', label: 'nav.cv' },
];
---

<header
  transition:name="header"
  transition:animate="none"
  class="sticky top-0 z-10 grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-3 bg-bg py-4 md:col-start-2 md:row-start-1 md:py-5"
>
  <!-- En escritorio la tarjeta de perfil ya muestra el nombre: la marca solo aparece en celular. -->
  <a href={pathFor('home', lang)} class="flex items-center gap-3 justify-self-start md:hidden">
    <img
      src="/favicon.svg"
      alt=""
      width="28"
      height="28"
      class="size-7 rounded-[28%] border border-dock-key-line"
    />
    <span translate="no" class="text-sm font-bold tracking-[0.08em] text-fg uppercase">
      {profile.name}
    </span>
  </a>

  <nav
    aria-label={t('nav.label')}
    class="col-span-2 row-start-2 lg:col-span-1 lg:col-start-1 lg:row-start-1"
  >
    <ul class="flex justify-between gap-1 md:justify-start md:gap-2">
      {tabs.map(({ route, label }) => (
        <li>
          <a
            href={pathFor(route, lang)}
            aria-current={route === currentRoute ? 'page' : undefined}
            class="nav-tab block rounded-full border border-transparent px-3 py-1.5 text-xs md:px-3.5 md:text-sm"
          >
            {t(label)}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="col-start-2 row-start-1 flex items-center gap-2 justify-self-end">
    <!-- En celular el menú se abre desde la tarjeta de perfil del inicio: aquí no cabe. -->
    <button
      type="button"
      data-command-menu-open
      aria-label={t('cmd.open')}
      aria-keyshortcuts="Control+K Meta+K"
      class="hidden size-8 place-items-center rounded-md border border-line text-fg-subtle transition-colors hover:border-button-line hover:text-fg md:grid"
    >
      <Icon name="lucide:search" class="size-3.5" aria-hidden="true" />
    </button>
    <LanguagePicker />
  </div>
</header>

<style>
  .nav-tab {
    color: var(--color-fg-subtle);
    transition:
      color 150ms ease-out,
      background-color 150ms ease-out;
  }

  .nav-tab[aria-current='page'] {
    border-color: var(--color-dock-key-line);
    background-color: var(--color-dock-key);
    color: var(--color-accent);
  }

  @media (hover: hover) {
    .nav-tab:not([aria-current='page']):hover {
      background-color: var(--color-surface-hover);
      color: var(--color-fg);
    }
  }
</style>
