---
// Monograma EA lineal (mismo dibujo que public/logo.svg) con el color del texto.
// La E es una { completa y la A va en dos piezas: un / y, aparte, la pierna derecha con el travesaño.
// E y A tienen un ancho parecido. El lienzo se centra en el cuerpo de las letras: la punta de la {
// sobresale como detalle óptico, si se contara empujaría el logo a la derecha.
type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="-11.4 -3 70 70"
  fill="none"
  stroke="currentColor"
  stroke-width="4.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  stroke-miterlimit="2"
  aria-hidden="true"
  class={className}
>
  <path d="M14 12H3L0 15V28L-5 32 0 36V49L3 52H14" />
  <path d="M-2 32H10" />
  <path d="M24.42 52 31.42 12" />
  <path d="M39.77 12 46.77 52M34.23 39H43.49" />
</svg>
