---
import { profile } from '@/data/profile';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { siteNav, type NavItem } from '@/lib/nav';

type Props = { lang: Lang };

const { lang } = Astro.props;
const t = useTranslations(lang);
const columns: { label: string; links: NavItem[] }[] = [
  {
    label: t('home.footer.nav'),
    links: siteNav(lang),
  },
  {
    label: t('home.footer.elsewhere'),
    links: [
      { label: t('nav.github'), href: profile.github },
      { label: t('nav.linkedin'), href: profile.linkedin },
      { label: 'Email', href: `mailto:${profile.email}` },
    ],
  },
];
---

<footer class="bg-ink px-[clamp(16px,4vw,48px)] pt-12 pb-24 text-sheet">
  <div class="mx-auto grid max-w-350 grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-8">
    {columns.map((col) => (
      <div>
        <p class="mb-3.5 text-[11px] tracking-[0.1em] uppercase opacity-70">{col.label}</p>
        <ul class="grid gap-1">
          {col.links.map((link) => (
            <li>
              <a
                href={link.href}
                {...(link.newTab && { target: '_blank', rel: 'noopener' })}
                class="inline-flex min-h-6 min-w-6 items-center no-underline hover:underline focus-visible:outline-sheet"
              >
                {link.label}
                {link.newTab && <span class="sr-only"> ({t('a11y.newTab')})</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="mx-auto mt-10 flex max-w-350 justify-between gap-4 border-t border-current pt-5 text-[11px] tracking-[0.1em] uppercase">
    <span>
      © {new Date().getFullYear()} {profile.name}
    </span>
    <a
      href="#main-content"
      class="-my-1 inline-flex min-h-6 items-center focus-visible:outline-sheet"
    >
      {t('home.footer.top')}
    </a>
  </div>
</footer>
