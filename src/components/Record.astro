---
// Cifras calculadas desde el contenido + índice de secciones del inicio.
import { cv } from '@/data/cv';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { getExperience, getProjects } from '@/lib/content';

type Props = {
  lang: Lang;
  sections: { id: string; label: string }[];
};

const { lang, sections } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);
const experience = await getExperience(lang);
const usedTech = new Set(projects.flatMap((p) => p.data.tech));

const stats = [
  { value: projects.length, label: t('home.record.projects') },
  { value: experience.length, label: t('home.record.institutions') },
  { value: usedTech.size, label: t('home.record.tech') },
  { value: cv.certifications.length, label: t('home.record.certs') },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section
  aria-label={t('home.record.label')}
  class="grid gap-[clamp(24px,4vw,56px)] border-y border-rule py-8 min-[900px]:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]"
>
  <ul class="grid grid-cols-2 gap-y-5 min-[900px]:grid-cols-4">
    {stats.map((stat) => (
      <li class="border-l border-rule px-4 py-1">
        <strong class="block font-display text-[clamp(3rem,6vw,4.5rem)] leading-none font-black italic">
          {stat.value}
        </strong>
        <span class="text-[11px] tracking-[0.08em] text-ink-muted uppercase">{stat.label}</span>
      </li>
    ))}
  </ul>
  <nav aria-label={t('home.contents')}>
    <p class="mb-3.5 text-[11px] tracking-[0.1em] text-ink-muted uppercase">{t('home.contents')}</p>
    <ol class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs tracking-[0.08em] uppercase">
      {sections.map((section, i) => (
        <li>
          <a href={`#${section.id}`} class="no-underline hover:underline">
            <span class="mr-1.5 text-ink-muted">{pad(i + 1)}</span>
            {section.label}
          </a>
        </li>
      ))}
    </ol>
  </nav>
</section>
