---
// Layout del inicio con el diseño "hoja". Las demás páginas siguen usando Layout.astro.
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import CommandMenu from '@/components/CommandMenu.astro';
import Seo from '@/components/Seo.astro';
import HomeFooter from '@/components/home/HomeFooter.astro';
import HomeHeader from '@/components/home/HomeHeader.astro';
import Preferences from '@/components/home/Preferences.astro';
import { profile } from '@/data/profile';
import { getLang, useTranslations } from '@/i18n/utils';

type Props = {
  description?: string;
};

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const { description = t('site.description') } = Astro.props;
const pageTitle = `${profile.name} · ${profile.role[lang]}`;
---

<html
  lang={lang}
  data-design="sheet"
  transition:name="root"
  transition:animate="none"
  class="scroll-smooth scroll-pt-18 scrollbar-thin scrollbar-thumb-rule scrollbar-track-transparent motion-reduce:scroll-auto"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={pageTitle} description={description} type="profile" />
    <slot name="head" />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <Font cssVariable="--font-barlow-condensed" preload />
    <!-- Tema elegido con el botón "Tema"; sin elección sigue al sistema. Se reaplica tras cada navegación. -->
    <script is:inline>
      (() => {
        const apply = () => {
          try {
            const saved = localStorage.getItem('theme');
            if (saved === 'light' || saved === 'dark')
              document.documentElement.dataset.theme = saved;
          } catch {
            // Sin almacenamiento (modo privado): el tema sigue al sistema.
          }
        };
        apply();
        if (!window.__themeAfterSwap) {
          window.__themeAfterSwap = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="bg-sheet-grid font-mono text-[15px] leading-relaxed text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only bg-brand text-sm font-bold text-on-brand focus-visible:not-sr-only focus-visible:fixed focus-visible:top-3 focus-visible:left-4 focus-visible:z-50 focus-visible:px-3 focus-visible:py-2"
    >
      {t('a11y.skip')}
    </a>
    <HomeHeader lang={lang} />
    <main id="main-content" class="mx-auto max-w-350 overflow-x-clip px-[clamp(16px,4vw,48px)]">
      <slot />
    </main>
    <HomeFooter lang={lang} />
    <Preferences lang={lang} />
    <CommandMenu />
  </body>
</html>
