---
import { Icon } from 'astro-icon/components';
import LanguagePicker from '@/components/LanguagePicker.astro';
import { profile } from '@/data/profile';
import { getLang, pathFor, useTranslations } from '@/i18n/utils';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<header
  transition:name="header"
  transition:animate="none"
  class="relative flex items-center justify-between gap-4 px-4 pt-6 md:justify-center md:px-8 md:pt-8"
>
  <a
    href={pathFor('home', lang)}
    translate="no"
    class="font-mono text-lg font-bold tracking-[0.08em] text-fg uppercase md:text-4xl"
  >
    {profile.name}
  </a>
  <div class="flex items-center gap-2 md:absolute md:top-8 md:right-8">
    <!-- En celular el menú se abre desde la tarjeta de perfil del inicio: aquí no cabe. -->
    <button
      type="button"
      data-command-menu-open
      aria-label={t('cmd.open')}
      aria-keyshortcuts="Control+K Meta+K"
      class="hidden h-8 items-center gap-2 rounded-md border border-line px-2.5 text-xs text-fg-subtle transition-colors hover:border-button-line hover:text-fg md:flex"
    >
      <Icon name="lucide:search" class="size-3.5" aria-hidden="true" />
      <kbd data-command-shortcut class="font-mono">
        Ctrl K
      </kbd>
    </button>
    <LanguagePicker />
  </div>
</header>
