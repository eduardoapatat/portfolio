---
import { contentTransition } from '@/lib/transitions';

type Props = {
  class?: string;
  /** id del título de la página: da nombre a la región para lectores de pantalla. */
  labelledby?: string;
};

const { class: className, labelledby = 'page-title' } = Astro.props;
---

<!-- tabindex: el panel tiene scroll propio y debe poder desplazarse con teclado aunque no tenga enlaces. -->
<section
  tabindex="0"
  aria-labelledby={labelledby}
  transition:name="content"
  transition:animate={contentTransition}
  class:list={[
    // Los rellenos superan la franja desvanecida (5 % del alto) para que el inicio y el final no se fundan.
    'content-panel h-full w-[92vw] max-w-7xl overflow-y-auto overscroll-contain bg-surface px-5 pt-14 pb-20 md:w-[80vw] md:px-10 md:pt-16 md:pb-24',
    className,
  ]}
>
  <slot />
</section>

<style>
  /* Bordes superior e inferior desvanecidos mientras el contenido se desplaza. */
  .content-panel {
    mask-image: linear-gradient(to bottom, transparent 0%, #000 5%, #000 95%, transparent 100%);
  }

  /* El contorno exterior lo recortaría la máscara: se dibuja hacia dentro. */
  .content-panel:focus-visible {
    outline-offset: -2px;
    border-radius: 0;
  }
</style>
