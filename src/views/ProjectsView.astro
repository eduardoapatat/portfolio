---
import ContentPanel from '@/components/ContentPanel.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { getProjects } from '@/lib/content';

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);
---

<ContentPanel>
  <header class="mb-10 max-w-[65ch]">
    <h1 id="page-title" class="text-3xl font-bold md:text-4xl">{t('projects.title')}</h1>
    <p class="mt-3 text-fg-subtle">{t('projects.note')}</p>
  </header>

  {
    projects.length > 0 ? (
      <ul class="flex flex-col gap-8">
        {projects.map((project) => (
          <li>
            <ProjectCard project={project} lang={lang} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="rounded-2xl border border-dashed border-line p-10 text-center text-fg-subtle">
        {t('projects.empty')}
      </p>
    )
  }
</ContentPanel>
