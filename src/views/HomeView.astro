---
// Inicio con el diseño "hoja": portada, experiencia, tecnologías, proyectos, formación y contacto.
import Contact from '@/components/home/Contact.astro';
import Education from '@/components/home/Education.astro';
import ExperienceTimeline from '@/components/home/ExperienceTimeline.astro';
import Hero from '@/components/home/Hero.astro';
import ProjectRows from '@/components/home/ProjectRows.astro';
import Record from '@/components/home/Record.astro';
import TechSkills from '@/components/home/TechSkills.astro';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

type Props = { lang: Lang };

const { lang } = Astro.props;
const t = useTranslations(lang);

// Orden de las secciones: el número y el índice salen de aquí.
const sections = [
  { id: 'experience', label: t('nav.experience') },
  { id: 'technologies', label: t('home.contents.tech') },
  { id: 'projects', label: t('nav.projects') },
  { id: 'education', label: t('home.contents.education') },
  { id: 'contact', label: t('home.contents.contact') },
];
const num = (id: string) => String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0');
---

<Hero lang={lang} />
<Record lang={lang} sections={sections} />
<ExperienceTimeline lang={lang} id="experience" num={num('experience')} />
<TechSkills lang={lang} id="technologies" num={num('technologies')} />
<ProjectRows lang={lang} id="projects" num={num('projects')} />
<Education lang={lang} id="education" num={num('education')} />
<Contact lang={lang} id="contact" num={num('contact')} />
