---
// Título o certificación: nombre, etiqueta de estado y quién lo otorga.
import Badge from '@/components/Badge.astro';

type Props = {
  title: string;
  badge: string;
  tone: 'success' | 'accent';
  detail: string;
};

const { title, badge, tone, detail } = Astro.props;
---

<article class="flex h-full flex-col gap-3 rounded-2xl border border-line bg-surface-raised p-5">
  <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
    <h3 class="min-w-0 flex-1 text-sm font-bold text-balance text-fg">{title}</h3>
    <Badge tone={tone}>{badge}</Badge>
  </div>
  <p class="mt-auto text-xs text-fg-subtle">{detail}</p>
</article>
