---
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import ContentPanel from '@/components/ContentPanel.astro';
import { cv } from '@/data/cv';
import { profile } from '@/data/profile';
import { defaultLang, type Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { getExperience } from '@/lib/content';
import { formatMonth, formatPeriod } from '@/lib/format';

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const t = useTranslations(lang);

const ownPdf = profile.cvPdf[lang];
const pdf = ownPdf ?? profile.cvPdf[defaultLang];

const experience = await Promise.all(
  (await getExperience(lang)).map(async (entry) => ({
    ...entry.data,
    Content: (await render(entry)).Content,
  })),
);

const displayUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const contacts = [
  { icon: 'tabler:map-pin', label: profile.location },
  { icon: 'tabler:mail', label: profile.email, href: `mailto:${profile.email}` },
  { icon: 'tabler:brand-linkedin', label: displayUrl(profile.linkedin), href: profile.linkedin },
  { icon: 'tabler:brand-github', label: displayUrl(profile.github), href: profile.github },
];
---

<ContentPanel>
  <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
    <h1 id="page-title" class="text-3xl font-bold md:text-4xl">
      {t('cv.title')}
    </h1>
    {pdf && (
      <a href={pdf} download class="cv-download">
        <Icon name="tabler:download" class="size-4" aria-hidden="true" />
        {ownPdf ? t('cv.download') : t('cv.downloadFallback')}
      </a>
    )}
  </header>

  <article class="cv-sheet grid overflow-hidden rounded-xl md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
    <div class="cv-aside flex flex-col gap-8 p-6 md:p-8">
      <div>
        <h2 class="text-2xl leading-tight font-bold text-pretty">{profile.name}</h2>
        <p class="cv-accent mt-2 font-medium">{profile.role[lang]}</p>
        <p class="cv-muted mt-2 text-xs leading-relaxed">{cv.headline[lang]}</p>
      </div>

      <section>
        <h3 class="cv-heading">{t('cv.contact')}</h3>
        <ul class="flex flex-col gap-2.5 text-sm">
          {contacts.map(({ icon, label, href }) => (
            <li class="flex items-center gap-3">
              <Icon name={icon} class="cv-muted size-4 shrink-0" aria-hidden="true" />
              {href ? (
                <a
                  href={href}
                  class="cv-link break-all"
                  {...(href.startsWith('http') && { target: '_blank', rel: 'noopener noreferrer' })}
                >
                  {label}
                </a>
              ) : (
                <span>{label}</span>
              )}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h3 class="cv-heading">{t('cv.summary')}</h3>
        <p class="text-sm leading-relaxed">{cv.summary[lang]}</p>
      </section>
    </div>

    <div class="flex flex-col gap-10 p-6 md:p-8">
      <section>
        <h3 class="cv-heading">{t('cv.experience')}</h3>
        <ol class="cv-timeline flex flex-col gap-7">
          {experience.map(({ company, role, location, start, end, Content }) => (
            <li class="relative pl-6">
              <p class="cv-accent text-sm font-bold">{company}</p>
              <p class="mt-0.5 font-bold">{role}</p>
              <p class="cv-muted mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs">
                {location && (
                  <span class="inline-flex items-center gap-1.5">
                    <Icon name="tabler:map-pin" class="size-3.5" aria-hidden="true" />
                    {location}
                  </span>
                )}
                <span class="inline-flex items-center gap-1.5">
                  <Icon name="tabler:calendar" class="size-3.5" aria-hidden="true" />
                  {formatPeriod(lang, start, end)}
                </span>
              </p>
              <div class="cv-body mt-3 text-sm leading-relaxed">
                <Content />
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section>
        <h3 class="cv-heading">{t('cv.education')}</h3>
        <ul class="flex flex-col gap-4 text-sm">
          {cv.education.map(({ institution, degree, status, location, start, end }) => (
            <li>
              <p class="cv-accent font-bold">{institution[lang]}</p>
              <p class="mt-0.5 font-bold">{`${degree[lang]} · ${status[lang]}`}</p>
              <p class="cv-muted mt-1 text-xs">
                {location} · {formatPeriod(lang, start, end)}
              </p>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h3 class="cv-heading">{t('cv.certifications')}</h3>
        <ul class="flex flex-col gap-3 text-sm">
          {cv.certifications.map(({ name, issuer, date }) => (
            <li>
              <p class="font-bold">{name}</p>
              <p class="cv-muted mt-0.5 text-xs">
                {issuer} · {formatMonth(lang, date)}
              </p>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h3 class="cv-heading">{t('cv.skills')}</h3>
        <ul class="cv-list flex flex-col gap-1.5 text-sm leading-relaxed">
          {cv.skills[lang].map((skill) => (
            <li>{skill}</li>
          ))}
        </ul>
      </section>

      <section>
        <h3 class="cv-heading">{t('cv.technologies')}</h3>
        <dl class="flex flex-col gap-3 text-sm">
          {cv.technologies.map(({ category, items }) => (
            <div>
              <dt class="font-bold">{category[lang]}</dt>
              <dd class="mt-1.5 flex flex-wrap gap-1.5">
                {(Array.isArray(items) ? items : items[lang]).map((item) => (
                  <span class="cv-chip">{item}</span>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </article>
</ContentPanel>

<style>
  /* La hoja del CV es clara a propósito: se lee como un documento impreso. */
  .cv-sheet {
    background-color: var(--color-cv-paper);
    color: var(--color-cv-ink);
  }

  .cv-aside {
    border-bottom: 1px solid var(--color-cv-line);
    background-color: var(--color-cv-aside);
  }

  @media (width >= 48rem) {
    .cv-aside {
      border-right: 1px solid var(--color-cv-line);
      border-bottom: none;
    }
  }

  .cv-heading {
    margin-bottom: 14px;
    border-bottom: 2px solid var(--color-cv-ink);
    padding-bottom: 6px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cv-accent {
    color: var(--color-cv-accent);
  }

  .cv-muted {
    color: var(--color-cv-muted);
  }

  .cv-link {
    text-decoration: underline;
    text-decoration-color: var(--color-cv-line);
    text-underline-offset: 3px;
    transition: text-decoration-color 150ms ease-out;
  }

  @media (hover: hover) {
    .cv-link:hover {
      text-decoration-color: var(--color-cv-accent);
    }
  }

  .cv-link:focus-visible,
  .cv-download:focus-visible {
    outline-color: var(--color-cv-accent);
  }

  /* Línea de tiempo: punto por empleo unido por una línea vertical. */
  .cv-timeline > li::before {
    content: '';
    position: absolute;
    top: 6px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    background-color: var(--color-cv-accent);
  }

  .cv-timeline > li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 20px;
    bottom: -22px;
    left: 4px;
    width: 1px;
    background-color: var(--color-cv-line);
  }

  .cv-body :global(ul),
  .cv-list {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    padding-left: 1.1em;
    list-style: disc;
  }

  .cv-body :global(li::marker),
  .cv-list li::marker {
    color: var(--color-cv-accent);
  }

  .cv-chip {
    border: 1px solid var(--color-cv-line);
    border-radius: 4px;
    background-color: var(--color-cv-aside);
    padding: 1px 8px;
    font-size: 12px;
  }

  .cv-download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 8px;
    background-color: var(--color-accent);
    padding: 9px 18px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-bg);
    transition: background-color 150ms ease-out;
  }

  @media (hover: hover) {
    .cv-download:hover {
      background-color: var(--color-accent-hover);
    }
  }
</style>
