---
import { render } from 'astro:content';
import ExperienceCard from '@/components/ExperienceCard.astro';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { getExperience } from '@/lib/content';

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const t = useTranslations(lang);
const experience = await getExperience(lang);

// Agrupa por año de inicio; getExperience ya viene ordenado de más reciente a más antiguo.
const groups = Map.groupBy(experience, (entry) => entry.data.start.getUTCFullYear());
const timeline = await Promise.all(
  [...groups].map(async ([year, entries]) => ({
    year,
    entries: await Promise.all(
      entries.map(async (entry) => ({ data: entry.data, Content: (await render(entry)).Content })),
    ),
  })),
);
---

<div class="py-6 md:py-10">
  <header class="mb-12 max-w-[65ch]">
    <h1 id="page-title" class="text-3xl font-bold md:text-4xl">
      {t('experience.title')}
    </h1>
    <p class="mt-3 text-fg-subtle">{t('experience.note')}</p>
  </header>

  <ol class="timeline relative">
    {timeline.map(({ year, entries }) => (
      <li class="relative grid gap-6 pb-14 last:pb-0 lg:grid-cols-[190px_minmax(0,1fr)] lg:gap-10">
        <div class="flex items-center gap-5 self-start bg-bg py-1 lg:sticky lg:top-20">
          <span class="timeline-dot" aria-hidden="true" />
          <h2 class="text-4xl font-bold text-fg-subtle md:text-5xl">{year}</h2>
        </div>

        <ul class="flex flex-col gap-5 pl-15 lg:pl-0">
          {entries.map(({ data, Content }) => (
            <li>
              <ExperienceCard entry={data} lang={lang} Content={Content} />
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</div>

<style>
  /* Línea vertical que une los marcadores de cada año. */
  .timeline::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 19px;
    width: 1px;
    background-color: var(--color-line);
  }

  .timeline-dot {
    position: relative;
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-line);
    border-radius: 9999px;
    background-color: var(--color-surface-raised);
  }

  .timeline-dot::after {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    background-color: var(--color-fg-subtle);
  }
</style>
