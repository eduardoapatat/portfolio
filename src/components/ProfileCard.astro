---
// Tarjeta de perfil con forma de celular: identidad, contacto, hora local y acceso al menú de comandos.
import { Icon } from 'astro-icon/components';
import Logo from '@/components/Logo.astro';
import { profile } from '@/data/profile';
import type { Lang } from '@/i18n/ui';
import { getRouteKey, useTranslations } from '@/i18n/utils';

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const t = useTranslations(lang);
// La tarjeta está en todas las páginas: el nombre es el <h1> solo en el inicio; en las demás lo es el título de la sección.
const Name = getRouteKey(Astro.url) === 'home' ? 'h1' : 'p';

const socials = [
  { href: profile.github, label: t('nav.github'), icon: 'lucide:github' },
  { href: profile.linkedin, label: t('nav.linkedin'), icon: 'lucide:linkedin' },
  { href: `mailto:${profile.email}`, label: profile.email, icon: 'lucide:mail' },
];
---

<!-- Estilo celular: marco del teléfono, barra de estado arriba y barra de direcciones de Safari abajo.
     En escritorio ocupa el alto de la columna. -->
<div class="h-full rounded-[2.75rem] border border-button-line bg-surface p-2">
  <div class="flex h-full flex-col overflow-hidden rounded-[2.25rem] border border-line bg-bg">
    <!-- Barra de estado: la hora de Arica la escribe el script; isla e íconos son decorativos. -->
    <div class="relative flex h-12 shrink-0 items-center justify-between px-7 text-[13px] font-bold text-fg">
      <span class="min-w-[6ch]">
        <span class="sr-only">{t('profile.localTime')}</span>
        <time
          data-clock
          data-locale={lang === 'es' ? 'es-CL' : 'en-US'}
          class="tabular-nums"
        ></time>
      </span>
      <span
        aria-hidden="true"
        class="absolute top-3 left-1/2 h-6 w-22 -translate-x-1/2 rounded-full bg-line"
      ></span>
      <span aria-hidden="true" class="flex items-center gap-1.5">
        <Icon name="lucide:signal-high" class="size-3.5" />
        <Icon name="lucide:wifi" class="size-3.5" />
        <Icon name="lucide:battery-full" class="size-5" />
      </span>
    </div>

    <div class="flex flex-1 flex-col justify-center px-6 py-6 text-center">
      <div class="mx-auto grid size-28 place-items-center rounded-[28%] border border-line bg-dock-key text-fg lg:size-32">
        <Logo class="size-20 lg:size-22" />
      </div>
      <Name
        id={Name === 'h1' ? 'page-title' : undefined}
        class="mt-5 text-xl font-bold text-balance text-fg"
      >
        {profile.name}
      </Name>
      <p class="mt-1 text-sm text-fg-subtle">{profile.role[lang]}</p>

      <div class="mx-auto mt-5 flex max-w-full items-center gap-1 rounded-full border border-line bg-surface-hover py-1 pr-1 pl-3.5 text-xs text-fg-muted">
        <span class="min-w-0 flex-1 truncate">{profile.email}</span>
        <button
          type="button"
          data-copy-email={profile.email}
          data-copied-label={t('profile.copied')}
          aria-label={t('profile.copy')}
          class="copy-button grid size-7 shrink-0 place-items-center rounded-full text-fg-subtle transition-colors hover:bg-line hover:text-fg"
        >
          <Icon name="lucide:copy" class="copy-icon size-3.5" aria-hidden="true" />
          <Icon name="lucide:check" class="check-icon size-3.5 text-success" aria-hidden="true" />
        </button>
      </div>
      <p data-copy-status role="status" class="sr-only"></p>

      <p class="mt-3 inline-flex items-center justify-center gap-1.5 text-xs text-fg-subtle">
        <Icon name="lucide:map-pin" class="size-3.5" aria-hidden="true" />
        {profile.location}
      </p>

      <ul class="mt-5 flex justify-center gap-2">
        {socials.map(({ href, label, icon }) => (
          <li>
            <a
              href={href}
              aria-label={label}
              target={href.startsWith('http') ? '_blank' : undefined}
              rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="grid size-9 place-items-center rounded-[10px] text-fg-muted transition-colors hover:bg-surface-hover hover:text-fg"
            >
              <Icon name={icon} class="size-4.5" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Barra de direcciones de Safari: abre el menú de comandos. -->
    <div class="px-4 pb-2.5">
      <button
        type="button"
        data-command-menu-open
        aria-keyshortcuts="Control+K Meta+K"
        class="flex h-12 w-full items-center gap-2.5 rounded-full border border-line bg-surface-hover pr-1.5 pl-4 text-left text-sm text-fg-subtle transition-colors hover:border-button-line hover:text-fg"
      >
        <Icon name="lucide:search" class="size-4 shrink-0" aria-hidden="true" />
        <span class="min-w-0 flex-1 truncate">{t('cmd.title')}</span>
        <span
          aria-hidden="true"
          class="grid size-9 shrink-0 place-items-center rounded-full bg-fg text-bg"
        >
          <Icon name="lucide:arrow-up-right" class="size-4" />
        </span>
      </button>
      <span
        aria-hidden="true"
        class="mx-auto mt-3 block h-1 w-28 rounded-full bg-button-line"
      ></span>
    </div>
  </div>
</div>

<style>
  .check-icon,
  .copy-button[data-copied] .copy-icon {
    display: none;
  }

  .copy-button[data-copied] .check-icon {
    display: block;
  }
</style>

<script>
  import { copyText } from '@/scripts/clipboard';

  let clock: number | undefined;

  function setupProfileCard() {
    const time = document.querySelector<HTMLTimeElement>('[data-clock]');
    if (time) {
      const format = new Intl.DateTimeFormat(time.dataset.locale, {
        hour: '2-digit',
        minute: '2-digit',
        // En Chile la hora se escribe en formato de 24 horas; en inglés, con AM/PM.
        hourCycle: time.dataset.locale === 'es-CL' ? 'h23' : 'h12',
        timeZone: 'America/Santiago',
      });
      const tick = () => {
        const now = new Date();
        time.textContent = format.format(now);
        time.dateTime = now.toISOString();
      };
      tick();
      clock = window.setInterval(tick, 30_000);
    }

    const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    button?.addEventListener('click', async () => {
      if (!(await copyText(button.dataset.copyEmail ?? ''))) return;
      button.dataset.copied = '';
      if (status) status.textContent = button.dataset.copiedLabel ?? '';
      setTimeout(() => {
        delete button.dataset.copied;
        if (status) status.textContent = '';
      }, 2000);
    });
  }

  document.addEventListener('astro:page-load', setupProfileCard);
  document.addEventListener('astro:before-swap', () => clearInterval(clock));
</script>
