---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SectionHead from '@/components/home/SectionHead.astro';
import { techIcon } from '@/data/tech';
import type { Lang } from '@/i18n/ui';
import { pathFor, useTranslations } from '@/i18n/utils';
import { getProjects } from '@/lib/content';

type Props = { lang: Lang; id: string; num: string };

const { lang, id, num } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);
const pad = (n: number) => String(n).padStart(2, '0');
const statusColor = {
  produccion: 'text-ok',
  prototipo: 'text-warn',
  desarrollo: 'text-warn',
} as const;
---

<section id={id} aria-labelledby={`${id}-title`} class="pt-[clamp(56px,9vw,112px)]">
  <SectionHead
    num={num}
    titleId={`${id}-title`}
    title={t('home.projects.title')}
    sub={t('home.projects.sub')}
    more={{ href: pathFor('projects', lang), label: t('home.projects.more') }}
  />

  <ol>
    {projects.map((p, i) => (
      <li class="grid gap-[clamp(24px,4vw,56px)] border-b border-rule py-10 min-[900px]:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
        <figure>
          {p.data.image && (
            <Image
              src={p.data.image}
              alt={p.data.imageAlt ?? ''}
              widths={[480, 800]}
              sizes="(min-width: 900px) 40vw, 100vw"
              class="block h-auto w-full border border-ink"
            />
          )}
          <figcaption class="mt-2 text-[11px] tracking-[0.1em] text-ink-muted uppercase">
            Fig. {pad(i + 2)} — {p.data.title}
          </figcaption>
        </figure>
        <div>
          <p class="mb-3 flex items-center gap-3.5 text-[11px] tracking-[0.1em] text-ink-muted uppercase">
            <span>{pad(i + 1)}</span>
            <span>{p.data.year}</span>
            {p.data.status && (
              <span class={`flex items-center gap-1.5 ${statusColor[p.data.status]}`}>
                <span class="size-1.75 rounded-full bg-current" aria-hidden="true" />
                {t(`projects.status.${p.data.status}`)}
              </span>
            )}
          </p>
          <h3 class="font-display text-[clamp(1.9rem,3.6vw,2.6rem)] leading-[0.95] font-extrabold text-balance uppercase italic">
            {p.data.title}
          </h3>
          <p class="mt-3.5 mb-4.5 max-w-[72ch] text-ink-muted">{p.data.summary}</p>
          <ul class="flex flex-wrap gap-2" aria-label={t('home.projects.tech')}>
            {p.data.tech.map((name) => {
              const icon = techIcon(name);
              return (
                <li class="flex items-center gap-1.5 border border-ink bg-chip px-2.5 py-1.25 text-xs font-medium text-[#0b0b0b]">
                  {icon && (
                    <Icon
                      name={icon.icon}
                      class="size-4"
                      style={`color:${icon.color}`}
                      aria-hidden="true"
                    />
                  )}
                  {name}
                </li>
              );
            })}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>
