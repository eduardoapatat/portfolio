---
import ProjectRow from '@/components/ProjectRow.astro';
import SectionHead from '@/components/SectionHead.astro';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { projectCategories } from '@/lib/categories';
import { getProjects } from '@/lib/content';

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);

// Solo las categorías que tienen proyectos, con su cantidad.
const filters = projectCategories
  .map((id) => ({ id, count: projects.filter((p) => p.data.categories.includes(id)).length }))
  .filter(({ count }) => count > 0);
const chip =
  'inline-flex cursor-pointer items-center gap-2 border-2 border-ink bg-sheet px-3 py-1.5 text-xs font-bold tracking-[0.06em] text-ink uppercase shadow-hard-2 hover:bg-brand hover:text-on-brand aria-pressed:bg-ink aria-pressed:text-sheet';
---

<div class="pt-[clamp(40px,7vw,88px)] pb-6">
  <SectionHead
    as="h1"
    num="02"
    titleId="page-title"
    title={t('home.projects.title')}
    sub={t('projects.note')}
  />

  {projects.length > 0 ? (
    <>
      {filters.length > 1 && (
        <div
          data-project-filters
          data-param={t('projects.filter.param')}
          role="group"
          aria-label={t('projects.filter')}
          class="mt-8 flex flex-wrap gap-2.5"
        >
          <button type="button" class={chip} data-filter="" aria-pressed="true">
            {t('projects.filter.all')}
            <span class="font-normal opacity-70">{projects.length}</span>
          </button>
          {filters.map(({ id, count }) => (
            <button type="button" class={chip} data-filter={id} aria-pressed="false">
              {t(`projects.filter.${id}`)}
              <span class="font-normal opacity-70">{count}</span>
            </button>
          ))}
        </div>
      )}

      <ol class="mt-4">
        {projects.map((project, index) => (
          <li
            data-categories={project.data.categories.join(' ')}
            class="border-b border-rule py-10"
          >
            <ProjectRow project={project} index={index} lang={lang} variant="full" />
          </li>
        ))}
      </ol>
    </>
  ) : (
    <p class="mt-10 border-2 border-dashed border-rule p-10 text-center text-ink-muted">
      {t('projects.empty')}
    </p>
  )}
</div>

<script>
  // Filtra la lista por categoría y guarda la elegida en la URL (?categoria=app) para compartirla.
  document.addEventListener('astro:page-load', () => {
    const group = document.querySelector<HTMLElement>('[data-project-filters]');
    if (!group) return;

    const param = group.dataset.param ?? 'categoria';
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...document.querySelectorAll<HTMLElement>('[data-categories]')];

    const apply = (filter: string) => {
      // Una categoría que no existe en los botones equivale a "Todos".
      const active = buttons.some((b) => b.dataset.filter === filter) ? filter : '';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === active)));
      items.forEach((item) => {
        item.hidden = active !== '' && !item.dataset.categories?.split(' ').includes(active);
      });
      return active;
    };

    apply(new URLSearchParams(location.search).get(param) ?? '');

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const active = apply(button.dataset.filter ?? '');
        const url = new URL(location.href);
        if (active) url.searchParams.set(param, active);
        else url.searchParams.delete(param);
        history.replaceState(history.state, '', url);
      }),
    );
  });
</script>
