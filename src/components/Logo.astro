---
// Monograma EA lineal (mismo dibujo que public/logo.svg) con el color del texto.
// La E es una { completa y la A va en dos piezas: un / y, aparte, la pierna derecha con el travesaño.
// Las dos separaciones miden lo mismo y el lienzo se centra en el ancho real (punta de la { incluida).
type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="-13.6 -4 72 72"
  fill="none"
  stroke="currentColor"
  stroke-width="4.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  stroke-miterlimit="2"
  aria-hidden="true"
  class={className}
>
  <path d="M11 12H3L0 15V28L-5 32 0 36V49L3 52H11" />
  <path d="M-2 32H7" />
  <path d="M21.56 52 30.56 12" />
  <path d="M41.67 12 50.67 52M34.54 39H45.5" />
</svg>
