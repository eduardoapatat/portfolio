# Seguridad: no ejecutar scripts de instalación (preinstall, install, postinstall) de las
# dependencias. Aplica a npm y a versiones antiguas de pnpm; pnpm 11 y posteriores ya los
# bloquean por defecto (allowBuilds) y solo leen de este archivo la configuración de registro
# y autenticación. Los scripts propios (pnpm build, npm run build…) siguen funcionando.
ignore-scripts=true
