---
// El funcionamiento imita la referencia (magnificación, tooltip, estado activo); el aspecto vive en <style>.
import { Icon } from 'astro-icon/components';
import { profile } from '@/data/profile';
import type { RouteKey } from '@/i18n/routes';
import type { UiKey } from '@/i18n/ui';
import { getLang, getRouteKey, pathFor, useTranslations } from '@/i18n/utils';

type DockItem = { label: UiKey; icon: string } & ({ route: RouteKey } | { href: string });

const items: DockItem[] = [
  { route: 'home', label: 'nav.home', icon: 'lucide:house' },
  { route: 'projects', label: 'nav.projects', icon: 'lucide:folder-code' },
  { route: 'experience', label: 'nav.experience', icon: 'lucide:briefcase-business' },
  { route: 'cv', label: 'nav.cv', icon: 'lucide:file-user' },
  { href: profile.github, label: 'nav.github', icon: 'lucide:github' },
  { href: profile.linkedin, label: 'nav.linkedin', icon: 'lucide:linkedin' },
];

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const currentRoute = getRouteKey(Astro.url);
---

<nav
  aria-label={t('nav.label')}
  transition:name="dock"
  transition:animate="none"
  class="flex justify-center px-4 pt-6 pb-2"
>
  <ul
    data-dock
    class="dock flex h-[68px] items-end gap-2 rounded-2xl px-3 pb-3 [--dock-base:44px] md:h-[72px] md:gap-3 md:px-4 md:[--dock-base:48px]"
  >
    {items.map((item) => {
      const isExternal = 'href' in item;
      const isActive = !isExternal && item.route === currentRoute;
      return (
        <li class="flex items-end">
          <a
            data-dock-item
            href={isExternal ? item.href : pathFor(item.route, lang)}
            aria-label={t(item.label)}
            aria-current={isActive ? 'page' : undefined}
            target={isExternal ? '_blank' : undefined}
            rel={isExternal ? 'noopener noreferrer' : undefined}
            class="dock-item group relative grid place-items-center"
          >
            <Icon name={item.icon} aria-hidden="true" class="dock-icon" />
            <span aria-hidden="true" class="dock-tip">
              {t(item.label)}
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .dock {
    border: 1px solid var(--color-line);
    background-color: var(--color-surface);
  }

  /* Tecla cuadrada con borde; el radio en % acompaña la magnificación. */
  .dock-item {
    width: var(--dock-size, var(--dock-base));
    height: var(--dock-size, var(--dock-base));
    border: 1px solid var(--color-dock-key-line);
    border-radius: 28%;
    color: var(--color-fg);
    background-color: var(--color-dock-key);
    transition:
      width 150ms ease-out,
      height 150ms ease-out,
      color 150ms ease-out,
      background-color 150ms ease-out,
      border-color 150ms ease-out;
  }

  .dock-item[aria-current='page'] {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background-color: var(--color-accent-soft);
  }

  /* Marca de la sección actual bajo la tecla. */
  .dock-item[aria-current='page']::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    translate: -50% 0;
    width: 12px;
    height: 3px;
    border-radius: 9999px;
    background-color: var(--color-accent);
  }

  .dock-item:focus-visible {
    --dock-size: 60px;
  }

  .dock-icon {
    width: 58%;
    height: 58%;
  }

  .dock-tip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    translate: -50% 4px;
    white-space: nowrap;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background-color: var(--color-surface);
    padding: 2px 8px;
    font-size: 12px;
    color: var(--color-fg);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 150ms ease-out,
      translate 150ms ease-out;
  }

  .dock-item:focus-visible .dock-tip {
    opacity: 1;
    translate: -50% 0;
  }

  /* En pantallas táctiles el :hover queda pegado tras tocar; solo con puntero real. */
  @media (hover: hover) {
    .dock-item:not([aria-current='page']):hover {
      border-color: var(--color-dock-key-hover-line);
      background-color: var(--color-dock-key-hover);
    }

    .dock-item:hover .dock-tip {
      opacity: 1;
      translate: -50% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock-item,
    .dock-tip {
      transition: none;
    }
  }
</style>

<script>
  import '@/scripts/dock';
</script>
